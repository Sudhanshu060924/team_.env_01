DATABASE_URL=
GROQ_API_KEY=

# Cloudinary — video storage (server-side only, never expose to frontend)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Comma-separated list of origins allowed by CORS.
# Must be explicit (no wildcard) because credentials (cookies) are used.
CORS_ORIGINS=http://localhost:3000

# Authentication
SECRET_KEY=change-me-in-production
# LLM model for chat/Q&A (Phase 7+)
GROQ_MODEL=llama-3.1-8b-instant
# Whisper model: "turbo" (default, faster) or "large" (most accurate)
WHISPER_MODEL=turbo
# ISO-639-1 language hint for Whisper (leave blank for auto-detect)
WHISPER_LANGUAGE=
TARGET_LANGUAGE=hi

# Audio preprocessing — FFmpeg pipeline
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_HIGHPASS=100
AUDIO_LOWPASS=8000
AUDIO_NOISE_REDUCTION=12
AUDIO_NOISE_FLOOR=-40

# Set to true to save cleaned audio chunks to backend/debug_audio/ (dev only)
SAVE_DEBUG_AUDIO=false

# ── Groq rate-limit management ────────────────────────────────────────────────
# Minimum seconds between topic detection calls (per lecture).
TOPIC_DETECTION_INTERVAL_SECONDS=30
# Minimum seconds between important-event detection calls (per lecture).
IMPORTANT_EVENT_INTERVAL_SECONDS=30
# Maximum characters sent to Groq in each context window.
MAX_TRANSLATION_CONTEXT_CHARS=4000
MAX_TOPIC_CONTEXT_CHARS=5000
MAX_EVENT_CONTEXT_CHARS=5000
# Maximum simultaneous in-flight Groq requests.
MAX_CONCURRENT_GROQ_REQUESTS=1
# Maximum 429 retry attempts per Groq call.
GROQ_MAX_RETRIES=2
# Minimum transcript length (chars) to bother calling Groq.
MIN_TRANSCRIPT_CHARS=10
